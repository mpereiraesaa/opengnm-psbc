#version 450
/* DXVK's DXBC translation shape: a separate sampler and sampled image that
 * the shader combines with OpSampledImage, a uniform texel buffer read with
 * texelFetch and a storage texel buffer written with imageStore. */
layout(local_size_x=8,local_size_y=1,local_size_z=1) in;
layout(set=0,binding=0) uniform sampler s0;
layout(set=0,binding=1) uniform texture2D t0;
layout(set=0,binding=2) uniform utextureBuffer typed_input;
layout(set=0,binding=3,r32ui) uniform writeonly uimageBuffer typed_output;
void main() {
    uint i=gl_GlobalInvocationID.x;
    vec4 texel=textureLod(sampler2D(t0,s0),vec2((float(i)+0.5)/8.0,0.5),0.0);
    uint fetched=texelFetch(typed_input,int(i)).x;
    uvec4 size=uvec4(textureSize(sampler2D(t0,s0),0),0,0);
    imageStore(typed_output,int(i),uvec4(packUnorm4x8(texel)^fetched^size.x,0,0,0));
}
