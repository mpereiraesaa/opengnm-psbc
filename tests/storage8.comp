#version 450
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
layout(local_size_x=1) in;
layout(set=0,binding=0,std430) readonly buffer A { uint8_t v[]; } a;
layout(set=0,binding=1,std430) writeonly buffer B { uint8_t v[]; } b;
void main() { b.v[0] = uint8_t(uint(a.v[0]) * 3u + 7u); }
