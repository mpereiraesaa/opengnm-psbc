#version 450
layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
layout(set=0,binding=0,r32ui) uniform uimage2D output_image;
layout(set=0,binding=1,std430) buffer Values { uint values[]; } input_values;
void main() {
    uint x=gl_GlobalInvocationID.x;
    uint y=gl_GlobalInvocationID.y;
    imageStore(output_image,ivec2(x,y),uvec4(input_values.values[y*8+x],0,0,1));
}
